# Generate two independent random hex strings; do not reuse the demo values.
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
NYALUME_TOKEN_SECRET=replace_with_another_64_random_hex_characters
# Production: chat.example.com, DNS pointing at your server; open TCP 80 and 443.
# Local test: http://localhost, HTTP_PORT=8088, HTTPS_PORT=8443
SITE_ADDRESS=http://localhost
HTTP_PORT=8088
HTTPS_PORT=8443
NYALUME_IMAGE=nyalume-web:local
# Public web uses only Qwen via Alibaba Cloud Model Studio (Beijing).
# Each user supplies their own Model Studio API Key in the web settings.
# Optional password reset emails. Hidden in UI unless HOST and FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_USE_SSL=0
SMTP_DAILY_LIMIT=200
WEB_MESSAGE_CHARS=16000
WEB_MEMORY_CHARS=12000
WEB_SESSIONS=100
WEB_SESSION_MESSAGES=2000
WEB_ACCOUNT_MESSAGES=20000
WEB_ACCOUNT_BYTES=134217728
WEB_CONTEXT_CHARS=48000
WEB_BODY_KIB=256
