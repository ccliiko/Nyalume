POSTGRES_PASSWORD=replace-with-a-long-database-password
NYALUME_TOKEN_SECRET=replace-with-at-least-32-random-characters
# 正式域名示例：https://nyalume.example.com
NYALUME_CORS_ORIGINS=http://127.0.0.1:8000

# 找回密码邮件（示例为 STARTTLS；使用 465 时设 SMTP_USE_SSL=1、SMTP_STARTTLS=0）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nyalume <no-reply@example.com>
SMTP_STARTTLS=1
SMTP_USE_SSL=0
